# Deployment mode: "development" or "production"
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./benefits_navigator.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/benefits_navigator

# LLM provider: "mock" (default, works offline, no key needed), "gemini", or "openai".
# For real AI extraction set the provider and paste your key, e.g.:
#   LLM_PROVIDER=gemini   LLM_API_KEY=<key from https://aistudio.google.com/apikey>
#   LLM_PROVIDER=openai   LLM_API_KEY=<key from https://platform.openai.com/api-keys>
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional. Defaults: gemini-2.5-flash (gemini) / gpt-4o-mini (openai)
LLM_MODEL=

# Embedding provider: "keyword" (default, no external calls) or "openai"
EMBEDDING_PROVIDER=keyword
EMBEDDING_API_KEY=

# Optional cloud speech providers (leave blank to use the browser voice fallback)
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_API_KEY=

VECTOR_DB_URL=

# Comma-separated list of allowed frontend origins. Must be an exact origin
# (not "*") for cookie-based auth to work across a cross-origin deployment;
# same-origin deployments (the docker-compose/nginx setup, local Vite proxy)
# never hit this path at all for normal app traffic.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Absolute path to seed_schemes.json inside the container/host. Only needed
# when the default relative lookup (../data/seed_schemes.json next to
# backend/) doesn't apply, e.g. in Docker where data/ is a separate mount.
SEED_DATA_PATH=

LOG_LEVEL=INFO

# --- Auth ---
# REQUIRED in any real deployment: a long random string, e.g. `openssl rand -hex 32`.
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Set explicitly to "false" if this deployment serves plain HTTP (no TLS) —
# otherwise browsers silently drop the auth cookies. Leave unset to follow
# ENVIRONMENT (Secure only when ENVIRONMENT=production).
COOKIE_SECURE=

# Optional: set both to seed a first admin account (idempotent) on startup.
# There is no open admin self-registration endpoint — this is the only way
# to create the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
